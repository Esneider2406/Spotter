# Copia este archivo como .env y reemplaza los valores. NUNCA subas el .env al repositorio.
PORT=4000
# Cadena de conexión PostgreSQL (local, Neon o Supabase)
DATABASE_URL=postgresql://usuario:clave@localhost:5432/spotter
# true cuando la BD está en la nube (Neon, Supabase, Render...)
DB_SSL=false
# Clave para firmar los tokens JWT: usa una cadena larga y aleatoria
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
# Origen(es) permitidos por CORS, separados por coma
CORS_ORIGIN=http://localhost:5173
